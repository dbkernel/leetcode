{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build current C++ file",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/build-cpp.sh",
        "${file}",
        "${fileDirname}",
        "${fileBasenameNoExtension}",
        "${fileExtname}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "detail": "Compile the active .cpp/.c file with g++ (rejects non-C++ files)"
    },
    {
      "label": "run current C++ file",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/build-cpp.sh",
        "${file}",
        "${fileDirname}",
        "${fileBasenameNoExtension}",
        "${fileExtname}",
        "--run"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "detail": "Compile and run the active .cpp/.c file"
    },
    {
      "label": "run current Go file",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/run-go.sh",
        "${file}",
        "${fileExtname}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "detail": "Run the active .go file"
    }
  ]
}
